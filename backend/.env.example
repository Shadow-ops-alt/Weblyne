# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/weblyne

# PGSSL options:
#   true     → SSL on, certificate verified   (production)
#   noverify → SSL on, self-signed cert OK    (staging / dev with SSL)
#   (unset)  → SSL off                        (local dev, no SSL)
PGSSL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# IMPORTANT: must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
JWT_EXPIRES_IN=7d

# ─── Email (Gmail SMTP via Nodemailer) ────────────────────────────────────────
EMAIL_USER=hello@weblyne.np
EMAIL_PASS=app-password-here
EMAIL_FROM="Weblyne <hello@weblyne.np>"
EMAIL_TO_ADMIN=hello@weblyne.np

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Additional CORS origins (comma-separated). In prod set to your Vercel URL:
# CORS_ALLOWED_ORIGINS=https://weblyne.vercel.app
CORS_ALLOWED_ORIGINS=

# ─── First admin (used by db/seed.js) ────────────────────────────────────────
# Change these BEFORE running db:seed in any non-local environment.
SEED_ADMIN_EMAIL=admin@weblyne.np
SEED_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

